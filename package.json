{
  "name": "sirna-pi",
  "version": "0.1.0",
  "private": true,
  "description": "A step-by-step learning project built on Pi Coding Agent.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "pi": "pi",
    "pi:minimax": "node scripts/pi-minimax.mjs",
    "pi:sdk": "node scripts/pi-sdk.mjs",
    "web": "node apps/api/bootstrap.mjs",
    "verify:first-task": "node scripts/verify-first-task.mjs",
    "verify:sdk-task": "node scripts/verify-first-task.mjs --sdk",
    "verify:web-task": "node scripts/verify-first-task.mjs --web",
    "check:tool-contract": "node scripts/check-tool-contract.mjs",
    "build:tool": "node scripts/build-tool-artifact.mjs",
    "tools:proposals": "node scripts/manage-tool-proposals.mjs",
    "test": "node --test tests/*.test.mjs",
    "pi:version": "pi --version",
    "pi:help": "pi --help"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
